{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Agents DomainUsers API",
    "version": "public_api-v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DomainUsers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns a list of spanning domain/tenant users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.backup.net/v1/spanning/domains/:domainId/users",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_number",
                "value": "",
                "type": "query",
                "description": "The page number. Default is 1."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The page size. Default is 50."
              }
            ]
          },
          "docs": "Visibility is restricted by tenant which issued credentials for access."
        }
      ]
    }
  ],
  "bundled": true
}