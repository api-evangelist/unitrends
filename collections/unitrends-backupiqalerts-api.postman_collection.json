                  "description": "The id of the customer in UUID format."
                },
                {
                  "disabled": false,
                  "key": "customer_name",
                  "value": "<string>",
                  "description": "The name of the customer. All of the customers that contain passed parameter will be in filtered result."
                },
                {
                  "disabled": false,
                  "key": "asset_tag",
                  "value": "<string>",
                  "description": "The id of the appliance."
                },
                {
                  "disabled": false,
                  "key": "appliance_name",
