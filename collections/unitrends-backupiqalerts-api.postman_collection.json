            "name": "Returns a list of BackupIQ alerts based on filtering, ordering and paging criteria.",
            "description": {
              "content": "Visibility is restricted by tenant which issued credentials for access.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "backupiq",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) The type of the alert."
                },
                {
                  "disabled": false,
                  "key": "severity",
                  "value": "<string>",
                  "description": "The severity of the alert."
                },
                {
                  "disabled": false,
                  "key": "is_muted",
                  "value": "<string>",
                  "description": "Indicates that alert is muted on UI by settings of alerts specified on the portal.\r\nMuted alerts are not displayed on the portal UI.\r\nAPI returns not muted alerts by default."
